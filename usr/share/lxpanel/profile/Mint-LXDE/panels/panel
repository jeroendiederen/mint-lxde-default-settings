# lxpanel <profile> config file. Manually editing is not recommended.
# Use preference dialog in lxpanel to adjust config when you can.

Global {
  edge=bottom
  allign=left
  margin=0
  widthtype=percent
  width=100
  height=24
  transparent=1
  tintcolor=#303030
  alpha=255
  setdocktype=1
  setpartialstrut=1
  usefontcolor=1
  fontcolor=#ffffff
  background=0
  backgroundfile=/usr/share/mint-lxde/images/background.png
  iconsize=22
}
Plugin {
  type=menu
  Config {
    image=/usr/share/icons/hicolor/scalable/apps/linuxmint-logo-ring-symbolic.svg
    system {
    }
    item {
      image=gnome-logout
      command=logout
    }
  }
}
Plugin {
  type=space
  Config {
    Size=4
  }
}
Plugin {
  type=space
  Config {
  }
}
Plugin {
  type=wincmd
  Config {
    image=user-desktop
    Button1=iconify
    Button2=shade
    Toggle=0
  }
}
Plugin {
  type=space
  Config {
    Size=4
  }
}
Plugin {
  type=launchbar
  Config {
    Button {
      id=arcticfox.desktop
    }
    Button {
      id=lxterminal.desktop
    }
    Button {
      id=pcmanfm.desktop
    }
  }
}
Plugin {
  type=space
  Config {
  }
}
Plugin {
  type=taskbar
  expand=1
  Config {
    tooltips=1
    IconsOnly=0
    ShowAllDesks=0
    UseMouseWheel=1
    UseUrgencyHint=1
    FlatButton=-1
    MaxTaskWidth=150
    spacing=1
    GroupedTasks=0
  }
}
Plugin {
  type=space
  Config {
    Size=2
  }
}
Plugin {
  type=tray
  Config {
  }
}
Plugin {
  type=batt
  Config {
    BackgroundColor=black
    ChargingColor1=#28f200
    ChargingColor2=#22cc00
    DischargingColor1=#ffee00
    DischargingColor2=#d9ca00
    HideIfNoBattery=1
    AlarmCommand=notify-send "Battery low" --icon=battery-caution
    AlarmTime=5
    BorderWidth=1
    Size=8
    ShowExtendedInformation=0
    BatteryNumber=0
  }
}
Plugin {
  type=volumealsa
  Config {
  }
}
Plugin {
  type=space
  Config {
    Size=2
  }
}
Plugin {
  type=dclock
  Config {
    ClockFmt=%H:%M
    TooltipFmt=%A %x
    BoldFont=0
    IconOnly=0
    CenterText=0
  }
}
Plugin {
  type=space
  Config {
    Size=6
  }
}
